# Copie este arquivo para .env e preencha. O .env nunca vai pro GitHub.

# /carrossel com foto IA (scripts/gerar-imagem.js)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# /foto-produto e /video-ia (scripts/kie.js) — chave em https://kie.ai
KIE_API_KEY=

# /aprovar-post (scripts/postar-instagram.js e postar-facebook.js)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# META_GRAPH_VERSION=v21.0
SITE_URL=https://seudominio.com.br

# Backup de vendas, clientes e memória (scripts/backup.js)
# Guarde a senha também FORA deste computador: sem ela, o backup não abre.
BACKUP_SENHA=
# Pasta do HD externo ou sincronizada com a nuvem. Padrão: ~/backups/mazyos
# BACKUP_DESTINO=/media/seu-usuario/HD/backups-mazyos
# BACKUP_MANTER=8
