{
  "_como_funciona": "Cada caso parte do projeto 'base', aplica 'ops' (fixtures/patch.js) e tem que ser recusado pelo schema com um problema de código e caminho iguais aos de 'expect'.",
  "base": "projects/motion-ad-4-scenes/project.mazy.json",
  "cases": [
    { "name": "campo desconhecido na raiz", "ops": [{ "op": "set", "path": "/extra", "value": 1 }], "expect": { "code": "SCHEMA_UNKNOWN_FIELD", "path": "/extra" } },
    { "name": "schemaVersion de outra série", "ops": [{ "op": "set", "path": "/schemaVersion", "value": "2.0.0" }], "expect": { "code": "SCHEMA_PATTERN", "path": "/schemaVersion" } },
    { "name": "campo obrigatório da raiz faltando", "ops": [{ "op": "remove", "path": "/export" }], "expect": { "code": "SCHEMA_REQUIRED", "path": "/export" } },
    { "name": "clientId com espaço e maiúscula", "ops": [{ "op": "set", "path": "/clientId", "value": "Cliente Exemplo" }], "expect": { "code": "SCHEMA_NO_MATCH", "path": "/clientId" } },
    { "name": "fps fora da lista", "ops": [{ "op": "set", "path": "/composition/fps", "value": 29.97 }], "expect": { "code": "SCHEMA_TYPE", "path": "/composition/fps" } },
    { "name": "largura ímpar", "ops": [{ "op": "set", "path": "/composition/width", "value": 1081 }], "expect": { "code": "SCHEMA_RANGE", "path": "/composition/width" } },
    { "name": "sem cenas", "ops": [{ "op": "set", "path": "/scenes", "value": [] }], "expect": { "code": "SCHEMA_RANGE", "path": "/scenes" } },
    { "name": "cena com duração zero", "ops": [{ "op": "set", "path": "/scenes/0/durationFrames", "value": 0 }], "expect": { "code": "SCHEMA_RANGE", "path": "/scenes/0/durationFrames" } },
    { "name": "duração com fração de quadro", "ops": [{ "op": "set", "path": "/scenes/0/durationFrames", "value": 96.5 }], "expect": { "code": "SCHEMA_TYPE", "path": "/scenes/0/durationFrames" } },
    { "name": "camada de texto sem o bloco text", "ops": [{ "op": "remove", "path": "/scenes/0/layers/2/text" }], "expect": { "code": "SCHEMA_REQUIRED", "path": "/scenes/0/layers/2/text" } },
    { "name": "camada de texto com bloco image", "ops": [{ "op": "set", "path": "/scenes/0/layers/2/image", "value": { "assetId": "foto-rosto" } }], "expect": { "code": "SCHEMA_UNKNOWN_FIELD", "path": "/scenes/0/layers/2/image" } },
    { "name": "tipo de camada que não existe", "ops": [{ "op": "set", "path": "/scenes/0/layers/0/type", "value": "video" }], "expect": { "code": "SCHEMA_ENUM", "path": "/scenes/0/layers/0/type" } },
    { "name": "campo desconhecido na camada", "ops": [{ "op": "set", "path": "/scenes/0/layers/0/blur", "value": 4 }], "expect": { "code": "SCHEMA_UNKNOWN_FIELD", "path": "/scenes/0/layers/0/blur" } },
    { "name": "cor fora do padrão", "ops": [{ "op": "set", "path": "/scenes/0/layers/2/text/color", "value": "white" }], "expect": { "code": "SCHEMA_PATTERN", "path": "/scenes/0/layers/2/text/color" } },
    { "name": "referência de marca que não existe", "ops": [{ "op": "set", "path": "/scenes/0/layers/2/text/color", "value": "brand.primary" }], "expect": { "code": "SCHEMA_PATTERN", "path": "/scenes/0/layers/2/text/color" } },
    { "name": "curva desconhecida", "ops": [{ "op": "set", "path": "/scenes/1/transitionIn/easing", "value": "bounce" }], "expect": { "code": "SCHEMA_NO_MATCH", "path": "/scenes/1/transitionIn/easing" } },
    { "name": "Bézier com x fora de 0 a 1", "ops": [{ "op": "set", "path": "/scenes/1/transitionIn/easing", "value": { "type": "cubicBezier", "x1": 2, "y1": 0, "x2": 0.5, "y2": 1 } }], "expect": { "code": "SCHEMA_RANGE", "path": "/scenes/1/transitionIn/easing/x1" } },
    { "name": "preset de animação desconhecido", "ops": [{ "op": "set", "path": "/scenes/0/layers/3/animations/0/preset", "value": "explode" }], "expect": { "code": "SCHEMA_ENUM", "path": "/scenes/0/layers/3/animations/0/preset" } },
    { "name": "trilha de propriedade não animável", "ops": [{ "op": "set", "path": "/scenes/0/layers/0/keyframes/width", "value": [{ "frame": 0, "value": 10 }] }], "expect": { "code": "SCHEMA_UNKNOWN_FIELD", "path": "/scenes/0/layers/0/keyframes/width" } },
    { "name": "quadro-chave sem valor", "ops": [{ "op": "remove", "path": "/scenes/0/layers/0/keyframes/scale/0/value" }], "expect": { "code": "SCHEMA_REQUIRED", "path": "/scenes/0/layers/0/keyframes/scale/0/value" } },
    { "name": "asset com caminho absoluto", "ops": [{ "op": "set", "path": "/assets/0/src", "value": "/home/usuario/foto.jpg" }], "expect": { "code": "SCHEMA_PATTERN", "path": "/assets/0/src" } },
    { "name": "asset saindo da pasta do projeto", "ops": [{ "op": "set", "path": "/assets/0/src", "value": "../../outro/foto.jpg" }], "expect": { "code": "SCHEMA_PATTERN", "path": "/assets/0/src" } },
    { "name": "asset com endereço da internet", "ops": [{ "op": "set", "path": "/assets/0/src", "value": "https://exemplo.com/foto.jpg" }], "expect": { "code": "SCHEMA_PATTERN", "path": "/assets/0/src" } },
    { "name": "forma sem preenchimento nem contorno", "ops": [{ "op": "remove", "path": "/scenes/0/layers/1/shape/fill" }], "expect": { "code": "SCHEMA_NO_MATCH", "path": "/scenes/0/layers/1/shape" } },
    { "name": "opacidade maior que 1", "ops": [{ "op": "set", "path": "/scenes/0/layers/1/opacity", "value": 1.2 }], "expect": { "code": "SCHEMA_RANGE", "path": "/scenes/0/layers/1/opacity" } },
    { "name": "exportação em outro formato", "ops": [{ "op": "set", "path": "/export/container", "value": "gif" }], "expect": { "code": "SCHEMA_ENUM", "path": "/export/container" } },
    { "name": "nome de arquivo com pasta", "ops": [{ "op": "set", "path": "/export/fileName", "value": "../fora.mp4" }], "expect": { "code": "SCHEMA_PATTERN", "path": "/export/fileName" } },
    { "name": "data sem fuso", "ops": [{ "op": "set", "path": "/project/createdAt", "value": "2026-11-11 10:00" }], "expect": { "code": "SCHEMA_PATTERN", "path": "/project/createdAt" } }
  ]
}
